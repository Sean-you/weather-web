# QWeather API Key Mode
QWEATHER_KEY=your_qweather_api_key_here

# OR QWeather JWT Mode (More Secure)
# QWEATHER_JWT_KEY=your_private_key_content
# QWEATHER_JWT_KID=your_key_id
# QWEATHER_JWT_SUB=your_project_id

# Client Configuration Defaults
WEATHER_LOCATION=101210101
WEATHER_AUTH_MODE=server
ASSETS_SOURCE=npm
CDN_BASE=https://cdn.cbd.int
PACKAGE_NAME=ink-weather-clock-static
VERSION=latest
